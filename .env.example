# ─────────────────────────────────────────────────────────────────────────────
# Legal Contract Intelligence — environment template (SAFE, no secrets).
#
# Copy the pieces you need:
#   • Backend reads its own file at  backend/.env  (see backend/.env.example).
#   • Frontend (Next.js) reads NEXT_PUBLIC_API_URL at BUILD time (Vercel env or
#     frontend/.env.local for local dev).
# On a hosting platform, set these as dashboard environment variables instead
# of committing any real file. Real .env files are git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ─── AI provider (Google Gemini) ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=
# "gemini" = live model, "mock" = fully offline deterministic demo (no key)
LLM_PROVIDER=gemini

# ─── Database (MySQL) ───
# Local dev (docker-compose.yml provides this instance):
DATABASE_URL=mysql+pymysql://root:admin@localhost:3306/legal_contract_intelligence
# Production managed MySQL — a plain mysql:// URL is auto-normalised to
# mysql+pymysql:// by the app, so you can paste your provider's string directly:
# DATABASE_URL=mysql://user:pass@host:3306/legal_contract_intelligence?ssl_mode=REQUIRED
# Seconds to wait for the MySQL connect/AUTH handshake before failing fast.
# Prevents an unreachable DB from hanging app startup (e.g. on Render deploys).
DB_CONNECT_TIMEOUT=10

# ─── Upload / processing ───
MAX_FILE_SIZE_MB=80
CHUNK_SIZE_WORDS=200
CHUNK_OVERLAP_WORDS=40

# ─── Server ───
# Allowed browser origins. Either a JSON list OR a plain comma-separated list
# works, e.g. CORS_ORIGINS=https://a.vercel.app,https://b.vercel.app
# Include your deployed frontend origin(s) here, e.g. your Vercel URL.
CORS_ORIGINS=["http://localhost:3000"]
# Writable directory for uploads + generated redlines. On Render, point this at
# a mounted persistent disk (see render.yaml / DEPLOYMENT.md).
# STORAGE_DIR=./backend/data

# ─── Frontend (Next.js) — read at BUILD time ───
# Base URL of the backend API. Local dev uses http://localhost:8000 (or
# 127.0.0.1); production uses the deployed backend URL, e.g.
# https://lci-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── AI (Google Gemini) ───
# Copy this file to backend/.env (gitignored) and fill in your key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Optional custom base URL / endpoint override
GEMINI_BASE_URL=
# Provider: "gemini" (live) or "mock" (offline deterministic demo, no key needed)
LLM_PROVIDER=gemini

# ─── Database (MySQL) ───
# Local dev example:
DATABASE_URL=mysql+pymysql://root:@localhost:3306/legal_contract_intelligence
# Production (Aiven / Railway / PlanetScale) uses an ssl-enabled URL, e.g.:
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/dbname?ssl_ca=ca.pem

# ─── Upload / processing ───
MAX_FILE_SIZE_MB=80
CHUNK_SIZE_WORDS=200
CHUNK_OVERLAP_WORDS=40

# ─── Server ───
CORS_ORIGINS=["http://localhost:3000"]

# ─── Frontend (Next.js) reads this at build time ───
NEXT_PUBLIC_API_URL=http://localhost:8000
